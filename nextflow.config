nextflow.enable.dsl = 2

// =============================================================================
// Pipeline parameters
// =============================================================================
params {
    samplesheet  = "${projectDir}/Samplesheets/example_samplesheet.csv"
    outdir       = "${projectDir}/results"

    // Reference — pre-built minimap2 index avoids re-indexing on every run
    genome_index = "/Zulu/timrez/genomeFiles/human/hg38/hg38.mmi"

    // MAPQ thresholds — pipeline produces one contact file per threshold per sample
    mapq_low     = 1
    mapq_high    = 30

    // Minimum number of mapped fragments for a read to be emitted as a contact
    min_frags    = 2

    // Threads for alignment and BAM sorting (one per chromosome)
    // Tip: set to 8 and keep executor.cpus=23 to run ~2 samples in parallel instead
    threads      = 23
}

// =============================================================================
// Executor — cap total cores used across all running processes
// =============================================================================
executor {
    name = 'local'
    cpus = 23   // never exceed 23 cores total; one ALIGN runs at a time at full bandwidth
}

// =============================================================================
// Singularity
// =============================================================================
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/Zulu/timrez/Containers/singularity_cache'
    runOptions = '--bind /Zulu:/Zulu,/Tango:/Tango'
}

// =============================================================================
// Profiles
// =============================================================================
profiles {
    standard {
        process.container = '/Zulu/timrez/Containers/hiporec.sif'
    }
}

// =============================================================================
// Per-process resource allocation
// =============================================================================
process {
    withName: 'ALIGN'         { cpus = params.threads }
    withName: 'SORT_INDEX_BAM' { cpus = params.threads }
    withName: 'NAMESORT_BAM'  { cpus = params.threads }
}

// =============================================================================
// Pipeline metadata
// =============================================================================
manifest {
    name        = 'Rowley_HiPoreC'
    version     = '0.1.0'
    description = 'Nextflow pipeline for HiPore-C long-read nanopore multiway chromatin contact analysis'
    author      = 'Rowley lab'
}
