Bootstrap: docker
From: ubuntu:22.04

%labels
    Author      Rowley lab
    Version     0.1.0
    Description HiPore-C pipeline container: minimap2, samtools, htslib, Python + pysam + pyarrow

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get -y update && apt-get -y install \
        wget curl bzip2 \
        python3 python3-pip \
        zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev \
        libncurses-dev libncurses5-dev \
        build-essential autoconf automake

    # -------------------------------------------------------------------------
    # minimap2 2.28 (pre-compiled x64 binary)
    # -------------------------------------------------------------------------
    wget -qO /tmp/minimap2.tar.bz2 \
        https://github.com/lh3/minimap2/releases/download/v2.28/minimap2-2.28_x64-linux.tar.bz2
    tar -xjf /tmp/minimap2.tar.bz2 -C /tmp/
    cp /tmp/minimap2-2.28_x64-linux/minimap2 /usr/local/bin/
    rm -rf /tmp/minimap2*

    # -------------------------------------------------------------------------
    # htslib 1.21 (provides bgzip + tabix)
    # -------------------------------------------------------------------------
    wget -qO /tmp/htslib.tar.bz2 \
        https://github.com/samtools/htslib/releases/download/1.21/htslib-1.21.tar.bz2
    tar -xjf /tmp/htslib.tar.bz2 -C /tmp/
    cd /tmp/htslib-1.21 && ./configure --prefix=/usr/local && make -j4 && make install
    cd / && rm -rf /tmp/htslib*

    # -------------------------------------------------------------------------
    # samtools 1.21
    # -------------------------------------------------------------------------
    wget -qO /tmp/samtools.tar.bz2 \
        https://github.com/samtools/samtools/releases/download/1.21/samtools-1.21.tar.bz2
    tar -xjf /tmp/samtools.tar.bz2 -C /tmp/
    cd /tmp/samtools-1.21 && ./configure --prefix=/usr/local && make -j4 && make install
    cd / && rm -rf /tmp/samtools*

    # -------------------------------------------------------------------------
    # Python packages
    # -------------------------------------------------------------------------
    pip3 install --no-cache-dir \
        pysam==0.22.1 \
        pandas==2.2.3 \
        pyarrow==17.0.0

    # Clean up
    apt-get -y clean && rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH

%test
    minimap2 --version
    samtools --version | head -1
    bgzip --version | head -1
    python3 -c "import pysam, pandas, pyarrow; print('Python packages OK')"
